# --- Django ---
DJANGO_SECRET_KEY=change-this-in-real-env
DJANGO_DEBUG=True
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1

# --- PostgreSQL (base de datos única del sistema) ---
POSTGRES_DB=lite_thinking_db
POSTGRES_USER=lite_thinking_user
POSTGRES_PASSWORD=lite_thinking_password
POSTGRES_HOST=localhost
POSTGRES_PORT=5432

# --- JWT (Django emite el token con el rol; FastAPI solo lo valida) ---
JWT_ALGORITHM=HS256
JWT_SIGNING_KEY=change-this-in-real-env
JWT_ACCESS_TOKEN_LIFETIME_HOURS=8
JWT_REFRESH_TOKEN_LIFETIME_DAYS=1

# --- CORS ---
CORS_ALLOWED_ORIGINS=http://localhost:3000

# --- Integración con FastAPI (ingesta automática de embeddings del
# agente de IA al crear/editar un Producto) ---
FASTAPI_API_URL=http://localhost:8001/api
