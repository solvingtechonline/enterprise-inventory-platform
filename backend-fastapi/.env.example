APP_NAME=Lite Thinking - Inventario Service
DEBUG=True

POSTGRES_DB=lite_thinking_db
POSTGRES_USER=lite_thinking_user
POSTGRES_PASSWORD=lite_thinking_password
POSTGRES_HOST=localhost
POSTGRES_PORT=5432

# Debe coincidir con la configuración JWT de Django
JWT_ALGORITHM=HS256
JWT_SIGNING_KEY=change-this-in-real-env

# URL interna de la API de Django, para leer Empresa/Productos al
# construir el PDF de Inventario (se reenvía el mismo token del
# Administrador, FastAPI no llama a Django con credenciales propias).
DJANGO_API_URL=http://localhost:8000/api

# Envío de correo del PDF de Inventario. Si SMTP_HOST
# queda vacío, el envío se simula en modo consola (se registra en el
# log), útil para probar el flujo sin un servidor SMTP real.
SMTP_HOST=smtp-relay.brevo.com
SMTP_PORT=587
SMTP_USER=b13bc4001@smtp-brevo.com
SMTP_PASSWORD=bskS1vNFT6zZ921
SMTP_USE_TLS=True
SMTP_FROM_EMAIL=soysamueltoro@gmail.com
SMTP_FROM_NAME=Lite Thinking - Inventario

CORS_ALLOWED_ORIGINS=http://localhost:3000

# Agente de IA con pgvector. Proveedor de embeddings configurable
# (EMBEDDINGS_PROVIDER=gemini u openai). Por defecto se usa Gemini
# porque su API tiene una capa gratuita real, sin tarjeta de crédito
# (ver docs/agente_ia_decision_proveedor.md). Consigue tu clave gratis
# en https://aistudio.google.com/apikey — sin esta clave, el resto del
# servicio sigue funcionando con normalidad; solo los endpoints de
# embeddings y búsqueda semántica responderán 502 Bad Gateway.
EMBEDDINGS_PROVIDER=gemini
EMBEDDINGS_DIMENSION=1536

GEMINI_API_KEY=
GEMINI_EMBEDDINGS_MODEL=gemini-embedding-001

# Alternativa de pago (requiere una compra prepagada mínima en OpenAI).
# Para usarla, cambia EMBEDDINGS_PROVIDER=openai arriba.
OPENAI_API_KEY=AQ.Ab8RN6KNZtnN9C156yX60f0Ly4GspccgQ7FD-kJFXMK71NYR8Q
OPENAI_EMBEDDINGS_MODEL=text-embedding-3-small
